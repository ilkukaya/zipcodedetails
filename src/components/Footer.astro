---
import Logo from './Logo.astro';
import { getStates, getMeta } from '../lib/data';
import { stateUrl } from '../lib/url';
import { SITE } from '../config/site';

const states = Object.entries(getStates())
  .filter(([abbr]) => abbr.length === 2)
  .sort((a, b) => a[1].name.localeCompare(b[1].name));
const meta = getMeta();
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Look up',
    links: [
      ['/search/', 'ZIP code lookup'],
      ['/what-is-my-zip-code/', 'What’s my ZIP code?'],
      ['/tools/zip-code-distance/', 'Distance between ZIP codes'],
      ['/tools/zip-code-radius/', 'ZIP codes within a radius'],
      ['/states/', 'Browse by state'],
    ],
  },
  {
    title: 'Rankings',
    links: [
      ['/rankings/richest-zip-codes/', 'Richest ZIP codes'],
      ['/rankings/most-expensive-zip-codes/', 'Most expensive ZIP codes'],
      ['/rankings/most-populated-zip-codes/', 'Most populated ZIP codes'],
      ['/rankings/most-densely-populated-zip-codes/', 'Densest ZIP codes'],
      ['/rankings/largest-zip-codes/', 'Largest ZIP codes by area'],
    ],
  },
  {
    title: 'Learn',
    links: [
      ['/guides/what-is-a-zip-code/', 'What is a ZIP code?'],
      ['/guides/us-zip-code-format/', 'ZIP code format'],
      ['/guides/zip-code-vs-postal-code/', 'ZIP vs. postal code'],
      ['/guides/how-to-find-your-zip-code/', 'How to find your ZIP'],
      ['/guides/what-is-zip-plus-4/', 'What is ZIP+4?'],
    ],
  },
  {
    title: 'Site',
    links: [
      ['/about/', 'About'],
      ['/data-sources/', 'Data sources & methodology'],
      ['/contact/', 'Contact'],
      ['/privacy/', 'Privacy policy'],
      ['/terms/', 'Terms of use'],
      ['/affiliate-disclosure/', 'Affiliate disclosure'],
    ],
  },
];
---

<footer class="mt-20 bg-ink text-paper/75">
  <div class="airmail h-1 w-full opacity-90" aria-hidden="true"></div>
  <div class="wrap py-14">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <a href="/" class="no-underline" aria-label="ZIPCodeDetails home"><Logo inverted /></a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed">
          A free, independent reference for {meta.zip_count.toLocaleString('en-US')} US ZIP codes —
          built on public data from the US Census Bureau and USPS.
        </p>
        <p class="mt-3 max-w-sm text-xs leading-relaxed text-paper/55">
          Not affiliated with the United States Postal Service. For official address validation use
          <a href="https://tools.usps.com/zip-code-lookup.htm" rel="noopener" target="_blank" class="text-paper/80 underline underline-offset-2 hover:text-white">USPS.com</a>.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {cols.map((c) => (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-paper/50">{c.title}</p>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map(([href, label]) => (
                <li><a href={href} class="lf">{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 border-t border-paper/10 pt-8">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-paper/50">ZIP codes by state</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[0.82rem] sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
        {states.map(([abbr, s]) => (
          <li><a href={stateUrl(abbr)} class="lf">{s.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-paper/10 pt-6 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.brand}. Data: US Census Bureau &amp; USPS (public domain).</p>
      <p>Last updated {meta.built}</p>
    </div>
  </div>
</footer>

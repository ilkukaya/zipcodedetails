---
interface Props {
  size?: 'sm' | 'lg';
  placeholder?: string;
  autofocus?: boolean;
  value?: string;
}

const { size = 'sm', placeholder = 'Enter a ZIP code, city or state', autofocus = false, value = '' } = Astro.props;
const lg = size === 'lg';
const uid = 'sb' + Math.random().toString(36).slice(2, 8);
---

<form
  action="/search/"
  method="get"
  role="search"
  class="relative w-full"
  data-searchbox
  data-uid={uid}
>
  <label for={`${uid}-input`} class="sr-only">Search ZIP codes, cities or states</label>
  <div class="relative">
    <svg
      class={`pointer-events-none absolute top-1/2 -translate-y-1/2 text-ink-3 ${lg ? 'left-5 h-5 w-5' : 'left-3 h-4 w-4'}`}
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
    ><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input
      id={`${uid}-input`}
      name="q"
      type="search"
      inputmode="search"
      enterkeyhint="search"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      value={value}
      placeholder={placeholder}
      autofocus={autofocus}
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${uid}-list`}
      class={lg
        ? 'h-16 w-full rounded-2xl border border-line-strong bg-surface pl-14 pr-32 text-lg text-ink shadow-lift outline-none transition placeholder:text-ink-4 focus:border-brand focus:ring-4 focus:ring-brand/15'
        : 'h-10 w-full rounded-lg border border-line bg-surface pl-9 pr-3 text-[0.92rem] text-ink outline-none transition placeholder:text-ink-4 focus:border-brand focus:ring-2 focus:ring-brand/15'}
    />
    {lg && (
      <button type="submit" class="absolute right-2 top-1/2 h-12 -translate-y-1/2 rounded-xl bg-ink px-5 text-[0.95rem] font-semibold text-white transition hover:bg-brand-dark">
        Search
      </button>
    )}
  </div>
  <ul
    id={`${uid}-list`}
    role="listbox"
    class="absolute left-0 right-0 z-50 mt-2 hidden max-h-[22rem] overflow-y-auto rounded-xl border border-line bg-surface py-1 text-left shadow-lift"
  ></ul>
</form>

<script>
  import { loadIndex, search, hitUrl, esc, STATE_NAMES, type Hit } from '../scripts/zipindex';

  function label(h: Hit): string {
    if (h.kind === 'zip') {
      return `<span class="zipcode text-ink">${esc(h.zip)}</span><span class="ml-2 text-ink-2">${esc(h.city)}, ${esc(h.state)}</span>`;
    }
    if (h.kind === 'city') {
      return `<span class="font-medium text-ink">${esc(h.city)}, ${esc(h.state)}</span><span class="ml-2 text-xs text-ink-3">${h.count} ZIP${h.count === 1 ? '' : 's'}</span>`;
    }
    return `<span class="font-medium text-ink">${esc(h.name)}</span><span class="ml-2 text-xs text-ink-3">State · all ZIP codes</span>`;
  }

  function kindTag(h: Hit): string {
    return h.kind === 'zip' ? 'ZIP' : h.kind === 'city' ? 'City' : 'State';
  }

  function init(form: HTMLFormElement) {
    const input = form.querySelector('input')!;
    const list = form.querySelector('ul')!;
    const uid = form.dataset.uid!;
    let hits: Hit[] = [];
    let active = -1;
    let seq = 0;

    const close = () => {
      list.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };

    const render = () => {
      if (!hits.length) {
        const q = input.value.trim();
        list.innerHTML = q.length >= 2
          ? `<li class="px-4 py-3 text-sm text-ink-3">No matches for “${esc(q)}”. Try a 5-digit ZIP or a city name.</li>`
          : '';
        list.classList.toggle('hidden', q.length < 2);
        return;
      }
      list.innerHTML = hits
        .map(
          (h, i) => `<li id="${uid}-o${i}" role="option" aria-selected="${i === active}">
            <a href="${hitUrl(h)}" class="flex items-center justify-between gap-3 px-4 py-2.5 text-[0.93rem] no-underline ${i === active ? 'bg-brand-soft' : 'hover:bg-paper'}">
              <span class="truncate">${label(h)}</span>
              <span class="shrink-0 font-mono text-[0.65rem] uppercase tracking-widest text-ink-4">${kindTag(h)}</span>
            </a></li>`
        )
        .join('');
      list.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      if (active >= 0) input.setAttribute('aria-activedescendant', `${uid}-o${active}`);
    };

    const run = async () => {
      const my = ++seq;
      const q = input.value;
      if (q.trim().length < 1 || (!/^\d/.test(q.trim()) && q.trim().length < 2)) {
        hits = [];
        close();
        return;
      }
      const rows = await loadIndex();
      if (my !== seq) return;
      hits = search(rows, q, 8);
      active = -1;
      render();
    };

    let t: number | undefined;
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(run, 90);
    });
    input.addEventListener('focus', () => {
      loadIndex();
      if (hits.length) render();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && hits.length) {
        e.preventDefault();
        active = (active + 1) % hits.length;
        render();
      } else if (e.key === 'ArrowUp' && hits.length) {
        e.preventDefault();
        active = (active - 1 + hits.length) % hits.length;
        render();
      } else if (e.key === 'Escape') {
        close();
      }
    });
    form.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (!q) {
        e.preventDefault();
        input.focus();
        return;
      }
      const five = q.replace(/\D/g, '');
      if (/^\d{5}(-?\d{4})?$/.test(q.replace(/\s/g, ''))) {
        e.preventDefault();
        location.href = `/zip/${five.slice(0, 5)}/`;
        return;
      }
      const pick = active >= 0 ? hits[active] : null;
      if (pick) {
        e.preventDefault();
        location.href = hitUrl(pick);
        return;
      }
      const st = Object.entries(STATE_NAMES).find(([a, n]) => n.toLowerCase() === q.toLowerCase() || a.toLowerCase() === q.toLowerCase());
      if (st) {
        e.preventDefault();
        location.href = `/state/${st[0].toLowerCase()}/`;
      }
      // otherwise fall through to /search/?q=
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) close();
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-searchbox]').forEach(init);
</script>

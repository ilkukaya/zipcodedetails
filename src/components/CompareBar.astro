---
/** Horizontal percentile bar: where a value sits within its state. */
interface Props {
  label: string;
  value: string;
  pct: number; // 0–100, share of state ZIPs below this value
  note: string;
}
const { label, value, pct, note } = Astro.props;
const clamped = Math.max(1, Math.min(99, pct));
---

<div>
  <div class="flex items-baseline justify-between gap-3">
    <p class="text-sm font-medium text-ink-2">{label}</p>
    <p class="num font-semibold text-ink">{value}</p>
  </div>
  <div class="relative mt-2 h-2.5 rounded-full bg-paper ring-1 ring-inset ring-line" aria-hidden="true">
    <div class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-brand/25 to-brand" style={`width:${clamped}%`}></div>
    <div class="absolute top-1/2 h-4 w-px -translate-y-1/2 bg-ink/40" style="left:50%"></div>
  </div>
  <p class="mt-1.5 text-xs text-ink-3">{note}</p>
</div>

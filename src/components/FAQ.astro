---
import { faqSchema, type FAQ } from '../lib/seo';

interface Props {
  faqs: FAQ[];
  heading?: string;
  id?: string;
  schema?: boolean;
}
const { faqs, heading = 'Frequently asked questions', id = 'faq', schema = true } = Astro.props;
---

{faqs.length > 0 && (
  <section id={id} class="scroll-mt-24" aria-labelledby={`${id}-h`}>
    <h2 id={`${id}-h`} class="h-section">{heading}</h2>
    <div class="mt-5 divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface">
      {faqs.map((f, i) => (
        <details class="group" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-[0.98rem] font-semibold text-ink hover:bg-paper/60">
            <h3 class="font-sans text-[0.98rem] font-semibold leading-snug">{f.question}</h3>
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-ink-3 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <div class="px-5 pb-5 text-[0.95rem] leading-relaxed text-ink-2">{f.answer}</div>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />}
  </section>
)}

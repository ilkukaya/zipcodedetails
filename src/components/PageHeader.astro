---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="max-w-3xl">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] sm:text-[2.75rem]">{title}</h1>
  {lede && <p class="mt-4 text-[1.08rem] leading-relaxed text-ink-2" data-answer>{lede}</p>}
  <slot />
</header>

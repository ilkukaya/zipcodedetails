---
import Logo from './Logo.astro';
import SearchBox from './SearchBox.astro';

interface Props {
  search?: boolean;
}
const { search = true } = Astro.props;

const nav = [
  { href: '/search/', label: 'ZIP Lookup' },
  { href: '/states/', label: 'States' },
  { href: '/rankings/', label: 'Rankings' },
  { href: '/tools/', label: 'Tools' },
  { href: '/guides/', label: 'Guides' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
  <div class="airmail h-1 w-full" aria-hidden="true"></div>
  <div class="wrap flex h-16 items-center gap-4">
    <a href="/" class="shrink-0 no-underline" aria-label="ZIPCodeDetails home">
      <Logo />
    </a>

    <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Main">
      {nav.map((n) => (
        <a
          href={n.href}
          class={`rounded-md px-3 py-2 text-[0.92rem] font-medium no-underline transition-colors ${
            current.startsWith(n.href) ? 'bg-ink/5 text-ink' : 'text-ink-2 hover:bg-ink/5 hover:text-ink'
          }`}
          aria-current={current.startsWith(n.href) ? 'page' : undefined}
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {search && (
        <div class="hidden w-72 md:block xl:w-80">
          <SearchBox size="sm" placeholder="ZIP, city or state" />
        </div>
      )}
      <a
        href="/search/"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-2 hover:bg-ink/5 md:hidden"
        aria-label="Search ZIP codes"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-2 hover:bg-ink/5 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-icon-open><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-icon-close><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-paper lg:hidden" aria-label="Mobile">
    <div class="wrap grid gap-1 py-3">
      {nav.map((n) => (
        <a href={n.href} class="rounded-lg px-3 py-3 text-base font-medium text-ink no-underline hover:bg-ink/5">{n.label}</a>
      ))}
      <a href="/what-is-my-zip-code/" class="rounded-lg px-3 py-3 text-base font-medium text-ink no-underline hover:bg-ink/5">What’s my ZIP code?</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu?.classList.toggle('hidden', open);
    btn.querySelector('[data-icon-open]')?.classList.toggle('hidden', !open);
    btn.querySelector('[data-icon-close]')?.classList.toggle('hidden', open);
  });
</script>

---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GeoMap from '../../components/GeoMap.astro';
import FAQ from '../../components/FAQ.astro';
import AdSlot from '../../components/AdSlot.astro';
import Stats from '../../components/Stats.astro';
import ZipTable from '../../components/ZipTable.astro';
import { getCounties, getZips, getMeta, type CountyInfo } from '../../lib/data';
import { formatNumber, formatMoney, formatArea, getTimezoneName, listJoin, citySlug, plural } from '../../lib/formatters';
import { cityUrl, countyUrl, stateUrl, zipUrl, abs } from '../../lib/url';
import { webPageSchema, clampDescription } from '../../lib/seo';

export function getStaticPaths() {
  return Object.entries(getCounties()).map(([slug, info]) => ({ params: { slug }, props: { slug, info } }));
}

const { slug, info } = Astro.props as { slug: string; info: CountyInfo };
const meta = getMeta();
const zips = getZips(info.zips);
const n = zips.length;
const path = countyUrl(slug);
const name = `${info.county}, ${info.state}`;
const topZips = zips.filter((z) => z.population).sort((a, b) => (b.population ?? 0) - (a.population ?? 0)).slice(0, 5);

const answer = `${info.county}, ${info.state_full} has ${plural(n, 'ZIP code')} covering ${plural(info.cities.length, 'city or town', 'cities and towns')}${info.cities.length ? `, including ${listJoin(info.cities.slice(0, 4))}` : ''}. ZIP codes range from ${info.zips[0]} to ${info.zips[n - 1]}${info.population ? ` and serve about ${formatNumber(info.population)} residents` : ''}.`;

const title = `${name} ZIP Codes – All ${n} ZIP Codes & Cities (Map)`;
const description = clampDescription(`List of all ${n} ZIP codes in ${info.county}, ${info.state_full}: ${info.zips.slice(0, 5).join(', ')}… with cities, population, income, and an interactive map.`);

const facts = [
  { k: 'ZIP codes', v: String(n) },
  { k: 'Cities & towns', v: String(info.cities.length) },
  ...(info.population ? [{ k: 'Population', v: formatNumber(info.population), sub: 'Sum of ZIP areas' }] : []),
  { k: 'State', v: info.state_full, href: stateUrl(info.state) },
  ...(info.avg_household_income ? [{ k: 'Household income', v: formatMoney(info.avg_household_income), sub: 'Pop.-weighted ZIP median' }] : []),
  ...(info.avg_home_value ? [{ k: 'Home value', v: formatMoney(info.avg_home_value), sub: 'Weighted ZIP median' }] : []),
  ...(info.land_area_sqmi ? [{ k: 'Land area', v: formatArea(info.land_area_sqmi), sub: 'ZIP areas combined' }] : []),
  ...(info.timezone ? [{ k: 'Time zone', v: getTimezoneName(info.timezone) }] : []),
];

const faqs = [
  { question: `How many ZIP codes are in ${name}?`, answer: `${info.county} has ${plural(n, 'ZIP code')}, from ${info.zips[0]} to ${info.zips[n - 1]}.` },
  { question: `What cities are in ${info.county}?`, answer: `ZIP codes in ${info.county} are assigned to ${listJoin(info.cities.slice(0, 12))}${info.cities.length > 12 ? `, and ${info.cities.length - 12} more` : ''}.` },
  ...(topZips.length ? [{ question: `What is the most populated ZIP code in ${info.county}?`, answer: `${topZips[0].zip} (${topZips[0].city}) is the most populated ZIP code in ${info.county}, with about ${formatNumber(topZips[0].population)} residents.` }] : []),
  { question: `What state is ${info.county} in?`, answer: `${info.county} is in ${info.state_full} (${info.state}).` },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: info.state_full, path: stateUrl(info.state) },
  { name: info.county, path },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AdministrativeArea',
  '@id': abs(path) + '#place',
  name: name,
  url: abs(path),
  geo: { '@type': 'GeoCoordinates', latitude: info.lat, longitude: info.lng },
  containedInPlace: { '@type': 'State', name: info.state_full, url: abs(stateUrl(info.state)) },
};
const points = zips.map((z) => ({ lat: z.lat, lng: z.lng, label: z.zip, href: zipUrl(z.zip) }));
---

<Base title={title} description={description} path={path} jsonLd={[schema, webPageSchema({ path, name: title, description, dateModified: meta.built, about: { '@id': abs(path) + '#place' } })]}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="min-w-0">
        <header>
          <p class="eyebrow">County ZIP codes · {info.state_full}</p>
          <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] sm:text-[2.75rem]">{info.county} ZIP Codes</h1>
          <p class="mt-5 max-w-2xl text-[1.05rem] leading-relaxed text-ink-2" data-answer>{answer}</p>
        </header>
        <div class="mt-8"><Stats items={facts} /></div>
        <div class="mt-8 lg:hidden"><GeoMap lat={info.lat} lng={info.lng} zoom={9} points={points} title={`ZIP codes in ${name}`} /></div>

        <AdSlot slot="top" />

        <section class="mt-10">
          <h2 class="h-section">Cities and towns in {info.county}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {info.cities.map((c) => <a href={cityUrl(citySlug(c, info.state))} class="chip">{c}</a>)}
          </div>
        </section>

        <section class="mt-10">
          <h2 class="h-section">All {n} ZIP codes in {info.county}</h2>
          <p class="mt-2 text-sm text-ink-3">Tap a column to sort.</p>
          <div class="mt-5"><ZipTable rows={zips} caption={`ZIP codes in ${name}`} /></div>
        </section>

        <AdSlot slot="inContent" />
        <div class="mt-12"><FAQ faqs={faqs} heading={`${info.county} ZIP code FAQ`} /></div>
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <GeoMap lat={info.lat} lng={info.lng} zoom={9} points={points} title={`ZIP codes in ${name}`} aspect="aspect-square" />
          <AdSlot slot="sidebar" class="!my-0" />
          <nav class="card p-5" aria-label="Explore">
            <p class="eyebrow">Explore</p>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a class="link" href={stateUrl(info.state)}>All {info.state_full} ZIP codes</a></li>
              <li><a class="link" href={`/top/${info.state.toLowerCase()}/`}>Top ZIP codes in {info.state_full}</a></li>
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</Base>

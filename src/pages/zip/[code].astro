---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GeoMap from '../../components/GeoMap.astro';
import FAQ from '../../components/FAQ.astro';
import AdSlot from '../../components/AdSlot.astro';
import Offers from '../../components/Offers.astro';
import CompareBar from '../../components/CompareBar.astro';
import { getAllZips, getMeta, type ZipRecord } from '../../lib/data';
import {
  formatNumber, formatMoney, formatArea, formatCoordinates, getTimezoneName, getTimezoneAbbr,
  getTimezoneUtc, ordinal, compare, listJoin,
} from '../../lib/formatters';
import { zipUrl, cityUrl, countyUrl, stateUrl, topUrl, abs } from '../../lib/url';
import { webPageSchema, clampDescription, type FAQ as FAQItem } from '../../lib/seo';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return [...getAllZips().values()].map((data) => ({ params: { code: data.zip }, props: { data } }));
}

const { data } = Astro.props as { data: ZipRecord };
const all = getAllZips();
const meta = getMeta();
const d = data;
const c = d.context;
const isPO = d.zip_type === 'PO BOX';
const typeLabel = isPO ? 'PO Box' : 'Standard';
const tzName = getTimezoneName(d.timezone);
const tzAbbr = getTimezoneAbbr(d.timezone);
const tzUtc = getTimezoneUtc(d.timezone);
const hasDemo = d.population != null && d.population > 0;
const path = zipUrl(d.zip);

const nearby = d.surrounding_zips
  .map((n) => ({ ...n, rec: all.get(n.zip) }))
  .filter((n) => n.rec);
const cityZips = d.city_zips.map((z) => all.get(z)).filter(Boolean) as ZipRecord[];

const occupancy = d.housing_units && d.occupied_housing_units != null
  ? Math.round((d.occupied_housing_units / d.housing_units) * 100)
  : null;

// ---- Copy ------------------------------------------------------------------
const answer = [
  `ZIP code ${d.zip} is a ${typeLabel.toLowerCase()} ZIP code in ${d.city}, ${d.county ? d.county + ', ' : ''}${d.state_full}.`,
  hasDemo && d.land_area_sqmi
    ? `It covers ${formatArea(d.land_area_sqmi)} of land and had a population of about ${formatNumber(d.population)}.`
    : isPO
      ? `It is used for post office boxes, so no residential population is reported for it.`
      : '',
  d.timezone ? `Local time follows ${tzName}${tzAbbr ? ` (${tzAbbr})` : ''}.` : '',
].filter(Boolean).join(' ');

const incomeCmp = compare(d.median_household_income, c.state_median_income);
const homeCmp = compare(d.median_home_value, c.state_median_home);

const about: string[] = [];
if (hasDemo) {
  about.push(
    `${d.zip} is home to roughly ${formatNumber(d.population)} people living in ${formatNumber(d.housing_units)} housing units` +
      (d.population_density ? `, a density of ${formatNumber(Math.round(d.population_density))} people per square mile` : '') +
      (c.pop_rank ? `. By population it ranks ${ordinal(c.pop_rank)} of ${formatNumber(c.pop_ranked)} populated ZIP codes in ${d.state_full}.` : '.')
  );
  if (d.median_household_income && incomeCmp) {
    about.push(
      `The median household income is ${formatMoney(d.median_household_income)}, ${incomeCmp} the typical ${d.state_full} ZIP code (${formatMoney(c.state_median_income)}).` +
        (d.median_home_value && homeCmp ? ` The median home value of ${formatMoney(d.median_home_value)} is ${homeCmp} the state’s ZIP-level median of ${formatMoney(c.state_median_home)}.` : '')
    );
  }
  if (occupancy != null) {
    about.push(`${occupancy}% of housing units are occupied${occupancy < 75 ? ', which often points to seasonal or vacation homes' : ''}.`);
  }
} else if (isPO) {
  about.push(
    `${d.zip} is a PO Box–only ZIP code. The Postal Service assigns these to banks of post office boxes rather than to street addresses, so mail addressed to ${d.zip} is picked up at the ${d.city} post office. Street addresses in ${d.city} use ${cityZips.length ? 'a different ZIP code such as ' + listJoin(cityZips.filter((z) => z.zip_type === 'STANDARD').slice(0, 3).map((z) => z.zip)) : 'a nearby standard ZIP code'}.`
  );
}
if (nearby.length) {
  about.push(
    `The closest ZIP codes are ${listJoin(nearby.slice(0, 3).map((n) => `${n.zip} (${n.rec!.city}, ${n.distance_mi} mi)`))}.`
  );
}

const faqs: FAQItem[] = [
  {
    question: `What city is ZIP code ${d.zip}?`,
    answer: `ZIP code ${d.zip} belongs to ${d.city}, ${d.state_full}${d.post_office_city ? `. USPS also accepts “${d.post_office_city}” as a city name for this ZIP.` : '.'}`,
  },
  {
    question: `What county is ${d.zip} in?`,
    answer: d.county ? `${d.zip} is in ${d.county}, ${d.state_full}.` : `County information is not available for ${d.zip}.`,
  },
  {
    question: `What time zone is ${d.zip} in?`,
    answer: `${d.zip} is in the ${tzName} zone${tzUtc ? ` (${tzUtc})` : ''}. ${d.dst === false ? 'Clocks do not change for daylight saving time.' : 'Daylight saving time is observed.'}`,
  },
  ...(hasDemo
    ? [{
        question: `What is the population of ${d.zip}?`,
        answer: `ZIP code ${d.zip} has a population of about ${formatNumber(d.population)}${d.population_density ? ` (${formatNumber(Math.round(d.population_density))} people per square mile)` : ''}, according to US Census Bureau data.`,
      }]
    : []),
  ...(d.median_household_income
    ? [{
        question: `What is the median household income in ${d.zip}?`,
        answer: `The median household income in ${d.zip} is ${formatMoney(d.median_household_income)}${c.income_pct != null ? `, higher than ${c.income_pct}% of ZIP codes in ${d.state_full}` : ''}. The median home value is ${formatMoney(d.median_home_value)}.`,
      }]
    : []),
  {
    question: `Is ${d.zip} a PO Box ZIP code?`,
    answer: isPO
      ? `Yes. ${d.zip} is reserved for post office boxes in ${d.city}, ${d.state}. It is not used for street delivery.`
      : `No. ${d.zip} is a standard ZIP code that covers street addresses and may also include PO boxes.`,
  },
  {
    question: `What ZIP codes are near ${d.zip}?`,
    answer: nearby.length
      ? `The nearest ZIP codes to ${d.zip} are ${listJoin(nearby.slice(0, 5).map((n) => `${n.zip} (${n.distance_mi} mi)`))}.`
      : `No nearby ZIP codes were found in ${d.state_full}.`,
  },
  {
    question: `How do I write an address with ZIP code ${d.zip}?`,
    answer: `Put the city, two-letter state code and ZIP on the last line, e.g. “${d.city.toUpperCase()} ${d.state} ${d.zip}”. Adding the ZIP+4 extension (${d.zip}-XXXX) can speed up delivery; look up the exact +4 for an address with the USPS ZIP code lookup tool.`,
  },
];

// ---- SEO -----------------------------------------------------------------
const title = `ZIP Code ${d.zip} – ${d.city}, ${d.state}${isPO ? ' (PO Box)' : ''}: Map, Demographics & Info`;
const description = clampDescription(
  hasDemo
    ? `${d.zip} is a ZIP code in ${d.city}, ${d.county ? d.county + ', ' : ''}${d.state_full}. Population ${formatNumber(d.population)}, median income ${formatMoney(d.median_household_income)}, home value ${formatMoney(d.median_home_value)}, map, time zone & nearby ZIPs.`
    : `${d.zip} is a ${typeLabel} ZIP code in ${d.city}, ${d.county ? d.county + ', ' : ''}${d.state_full}. See the map, time zone, county, and nearby ZIP codes for ${d.zip}.`
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.state_full, path: stateUrl(d.state) },
  ...(d.county ? [{ name: d.county, path: countyUrl(d.county_slug) }] : []),
  { name: `${d.city}`, path: cityUrl(d.city_slug) },
  { name: d.zip, path },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  '@id': abs(path) + '#place',
  name: `ZIP Code ${d.zip}, ${d.city}, ${d.state}`,
  url: abs(path),
  address: {
    '@type': 'PostalAddress',
    postalCode: d.zip,
    addressLocality: d.city,
    addressRegion: d.state,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  containedInPlace: [
    { '@type': 'City', name: `${d.city}, ${d.state}`, url: abs(cityUrl(d.city_slug)) },
    ...(d.county ? [{ '@type': 'AdministrativeArea', name: d.county, url: abs(countyUrl(d.county_slug)) }] : []),
    { '@type': 'State', name: d.state_full, url: abs(stateUrl(d.state)) },
  ],
  ...(hasDemo
    ? {
        additionalProperty: [
          { '@type': 'PropertyValue', name: 'Population', value: d.population },
          ...(d.median_household_income ? [{ '@type': 'PropertyValue', name: 'Median household income', value: d.median_household_income, unitCode: 'USD' }] : []),
          ...(d.land_area_sqmi ? [{ '@type': 'PropertyValue', name: 'Land area', value: d.land_area_sqmi, unitText: 'square miles' }] : []),
        ],
      }
    : {}),
};
const pageSchema = webPageSchema({ path, name: title, description, dateModified: meta.built, about: { '@id': abs(path) + '#place' } });

const facts: { k: string; v: string; href?: string; sub?: string }[] = [
  { k: 'City', v: d.city, href: cityUrl(d.city_slug), sub: d.city_zip_count > 1 ? `${d.city_zip_count} ZIP codes` : 'Only ZIP in city' },
  { k: 'County', v: d.county || '—', href: d.county ? countyUrl(d.county_slug) : undefined },
  { k: 'State', v: d.state_full, href: stateUrl(d.state), sub: d.state },
  { k: 'Time zone', v: tzName, sub: [tzAbbr, tzUtc].filter(Boolean).join(' · ') },
  ...(hasDemo
    ? [
        { k: 'Population', v: formatNumber(d.population), sub: c.pop_rank ? `${ordinal(c.pop_rank)} in ${d.state}` : undefined },
        { k: 'Median household income', v: formatMoney(d.median_household_income), sub: c.income_pct != null ? `Top ${Math.max(1, 100 - c.income_pct)}% in ${d.state}` : undefined },
        { k: 'Median home value', v: formatMoney(d.median_home_value), sub: c.home_pct != null ? `Top ${Math.max(1, 100 - c.home_pct)}% in ${d.state}` : undefined },
        { k: 'Housing units', v: formatNumber(d.housing_units), sub: occupancy != null ? `${occupancy}% occupied` : undefined },
      ]
    : []),
  ...(d.land_area_sqmi != null ? [{ k: 'Land area', v: formatArea(d.land_area_sqmi), sub: d.water_area_sqmi ? `+ ${formatArea(d.water_area_sqmi)} water` : undefined }] : []),
  { k: 'Coordinates', v: formatCoordinates(d.lat, d.lng), sub: 'Approximate center' },
  { k: 'ZIP type', v: typeLabel, sub: isPO ? 'PO boxes only' : 'Street delivery' },
  ...(d.population_density ? [{ k: 'Density', v: `${formatNumber(Math.round(d.population_density))} / sq mi`, sub: c.density_pct != null ? `Denser than ${c.density_pct}% in ${d.state}` : undefined }] : []),
];
---

<Base title={title} description={description} path={path} jsonLd={[placeSchema, pageSchema]}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="min-w-0">
        <!-- Hero -->
        <header>
          <p class="eyebrow flex items-center gap-2">
            <span class={`inline-block h-2 w-2 rounded-full ${isPO ? 'bg-stamp' : 'bg-good'}`}></span>
            {typeLabel} ZIP code · {d.state_full}
          </p>
          <h1 class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="font-display text-[2.1rem] font-semibold leading-none sm:text-5xl">ZIP Code</span>
            <span class="zipcode rounded-lg border-2 border-ink px-3 py-1 text-[2.1rem] leading-none sm:text-5xl">{d.zip}</span>
          </h1>
          <p class="mt-3 font-display text-xl text-ink-2 sm:text-2xl">
            <a href={cityUrl(d.city_slug)} class="text-ink-2 no-underline hover:text-brand">{d.city}</a>,
            <a href={stateUrl(d.state)} class="text-ink-2 no-underline hover:text-brand">{d.state_full}</a>
          </p>
          <p class="mt-5 max-w-2xl text-[1.05rem] leading-relaxed text-ink-2" data-answer>{answer}</p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <button type="button" class="btn-ghost" data-copy={d.zip}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></svg>
              <span data-copy-label>Copy ZIP</span>
            </button>
            {d.timezone && (
              <span class="chip cursor-default hover:border-line hover:text-ink-2" data-clock={d.timezone}>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                Local time <strong class="num font-semibold text-ink" data-clock-value>—</strong>
              </span>
            )}
            <a href={`/tools/zip-code-radius/?zip=${d.zip}`} class="chip">ZIPs within 10 miles</a>
            <a href={`/tools/zip-code-distance/?from=${d.zip}`} class="chip">Distance from {d.zip}</a>
          </div>
        </header>

        <!-- Key facts -->
        <section class="mt-10" aria-labelledby="facts-h">
          <h2 id="facts-h" class="sr-only">Key facts for ZIP code {d.zip}</h2>
          <dl class="grid grid-cols-2 overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3" style="gap:1px">
            {facts.map((f) => (
              <div class="bg-surface p-4">
                <dt class="eyebrow !text-[0.66rem]">{f.k}</dt>
                <dd class="mt-1.5 text-[1.02rem] font-semibold leading-snug text-ink">
                  {f.href ? <a href={f.href} class="text-ink underline decoration-line-strong underline-offset-4 hover:text-brand hover:decoration-brand">{f.v}</a> : f.v}
                </dd>
                {f.sub && <dd class="mt-0.5 text-xs text-ink-3">{f.sub}</dd>}
              </div>
            ))}
          </dl>
          {hasDemo && <p class="mt-2 text-xs text-ink-4">Demographics: US Census Bureau ({SITE.dataVintage}). Figures are estimates.</p>}
        </section>

        <div class="mt-8 lg:hidden">
          <GeoMap lat={d.lat} lng={d.lng} bounds={d.bounds} title={`ZIP ${d.zip} · ${d.city}, ${d.state}`} />
        </div>

        <AdSlot slot="top" />

        {hasDemo && (c.income_pct != null || c.home_pct != null || c.density_pct != null) && (
          <section class="mt-10" aria-labelledby="cmp-h">
            <h2 id="cmp-h" class="h-section">How {d.zip} compares to {d.state_full}</h2>
            <p class="mt-2 text-sm text-ink-3">Bars show where {d.zip} falls among all {d.state_full} ZIP codes. The tick marks the state median.</p>
            <div class="card mt-5 grid gap-6 p-5 sm:p-6">
              {c.income_pct != null && (
                <CompareBar label="Median household income" value={formatMoney(d.median_household_income)} pct={c.income_pct}
                  note={`Higher than ${c.income_pct}% of ${d.state} ZIP codes · state median ${formatMoney(c.state_median_income)}`} />
              )}
              {c.home_pct != null && (
                <CompareBar label="Median home value" value={formatMoney(d.median_home_value)} pct={c.home_pct}
                  note={`Higher than ${c.home_pct}% of ${d.state} ZIP codes · state median ${formatMoney(c.state_median_home)}`} />
              )}
              {c.density_pct != null && (
                <CompareBar label="Population density" value={`${formatNumber(Math.round(d.population_density!))} / sq mi`} pct={c.density_pct}
                  note={`Denser than ${c.density_pct}% of ${d.state} ZIP codes`} />
              )}
            </div>
            <p class="mt-3 text-sm"><a href={topUrl(d.state)} class="link">See the top ZIP codes in {d.state_full} →</a></p>
          </section>
        )}

        {about.length > 0 && (
          <section class="mt-10" aria-labelledby="about-h">
            <h2 id="about-h" class="h-section">About ZIP code {d.zip}</h2>
            <div class="mt-4 max-w-3xl space-y-4 text-[1.02rem] leading-relaxed text-ink-2">
              {about.map((p) => <p>{p}</p>)}
            </div>
          </section>
        )}

        <section class="mt-10" aria-labelledby="near-h">
          <div class="flex items-end justify-between gap-3">
            <h2 id="near-h" class="h-section">ZIP codes near {d.zip}</h2>
            <a href={`/tools/zip-code-radius/?zip=${d.zip}&r=25`} class="shrink-0 text-sm link">Search a radius →</a>
          </div>
          <div class="card mt-5 overflow-x-auto">
            <table class="data-table">
              <thead><tr><th scope="col">ZIP</th><th scope="col">City</th><th scope="col" class="hidden sm:table-cell">County</th><th scope="col" class="text-right">Distance</th></tr></thead>
              <tbody>
                {nearby.map((n) => (
                  <tr>
                    <td><a href={zipUrl(n.zip)} class="lz">{n.zip}</a></td>
                    <td><a href={cityUrl(n.rec!.city_slug)} class="lm">{n.rec!.city}</a></td>
                    <td class="hidden sm:table-cell text-ink-3">{n.rec!.county}</td>
                    <td class="num text-right text-ink-3">{n.distance_mi} mi</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {cityZips.length > 0 && (
            <div class="mt-6">
              <h3 class="font-sans text-base font-semibold text-ink">Other ZIP codes in {d.city}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {cityZips.map((z) => (
                  <a href={zipUrl(z.zip)} class="chip"><span class="zipcode">{z.zip}</span>{z.zip_type === 'PO BOX' && <span class="text-[0.7rem] text-ink-4">PO Box</span>}</a>
                ))}
                {d.city_zip_count - 1 > cityZips.length && <a href={cityUrl(d.city_slug)} class="chip">All {d.city_zip_count} →</a>}
              </div>
            </div>
          )}
        </section>

        <div class="mt-12">
          <Offers city={d.city} state={d.state} stateFull={d.state_full} zip={d.zip} lat={d.lat} lng={d.lng} />
        </div>

        <AdSlot slot="inContent" />

        <div class="mt-12">
          <FAQ faqs={faqs} heading={`${d.zip} ZIP code FAQ`} />
        </div>

        <section class="mt-10 rounded-xl border border-dashed border-line-strong p-5 text-sm text-ink-3" aria-label="Sources">
          <p><strong class="text-ink-2">Sources.</strong> Location and boundaries: US Census Bureau ZCTA gazetteer. City and ZIP type: USPS. Demographics: US Census Bureau ({SITE.dataVintage}). <a href="/data-sources/" class="link">Methodology</a>.</p>
          <p class="mt-2"><strong class="text-ink-2">Cite this page.</strong> “ZIP Code {d.zip} – {d.city}, {d.state}.” {SITE.brand}, {abs(path)}. Updated {meta.built}.</p>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <GeoMap lat={d.lat} lng={d.lng} bounds={d.bounds} title={`ZIP ${d.zip} · ${d.city}, ${d.state}`} aspect="aspect-square" />

          <div class="card p-5">
            <p class="eyebrow">Mailing format</p>
            <div class="mt-3 rounded-lg border border-line bg-paper px-4 py-3 font-mono text-[0.82rem] leading-relaxed text-ink">
              JANE DOE<br />123 MAIN ST<br />{d.city.toUpperCase()} {d.state} {d.zip}
            </div>
            <p class="mt-2 text-xs text-ink-3">USPS-preferred last line for {d.zip}.</p>
          </div>

          <AdSlot slot="sidebar" class="!my-0" />

          <nav class="card p-5" aria-label="Explore">
            <p class="eyebrow">Explore</p>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li><a class="link" href={cityUrl(d.city_slug)}>All ZIP codes in {d.city}</a></li>
              {d.county && <li><a class="link" href={countyUrl(d.county_slug)}>ZIP codes in {d.county}</a></li>}
              <li><a class="link" href={stateUrl(d.state)}>{d.state_full} ZIP code list</a></li>
              <li><a class="link" href={topUrl(d.state)}>Top ZIP codes in {d.state}</a></li>
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const label = b.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(b.dataset.copy || '');
        if (label) label.textContent = 'Copied!';
      } catch {
        if (label) label.textContent = b.dataset.copy || '';
      }
      setTimeout(() => label && (label.textContent = 'Copy ZIP'), 1600);
    });
  });
  document.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => {
    const out = el.querySelector('[data-clock-value]');
    if (!out) return;
    let fmt: Intl.DateTimeFormat;
    try {
      fmt = new Intl.DateTimeFormat('en-US', { timeZone: el.dataset.clock, hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
    } catch {
      el.remove();
      return;
    }
    const tick = () => (out.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  });
</script>

---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import AdSlot from '../../components/AdSlot.astro';
import RankTable from '../../components/RankTable.astro';
import { getStates, getRankings, getMeta, type StateInfo } from '../../lib/data';
import { formatNumber, formatMoney, formatArea } from '../../lib/formatters';
import { stateUrl, topUrl } from '../../lib/url';
import { webPageSchema, clampDescription } from '../../lib/seo';

export function getStaticPaths() {
  const r = getRankings();
  return Object.entries(getStates())
    .filter(([abbr]) => r.states[abbr])
    .map(([abbr, info]) => ({ params: { state: abbr.toLowerCase() }, props: { abbr, info } }));
}

const { abbr, info } = Astro.props as { abbr: string; info: StateInfo };
const meta = getMeta();
const t = getRankings().states[abbr];
const path = topUrl(abbr);
const title = `Richest, Most Expensive & Largest ZIP Codes in ${info.name} (Ranked)`;
const description = clampDescription(`Ranked lists of ${info.name} ZIP codes: highest median household income, most expensive homes, most populated and largest by land area, from US Census data.`);

const sections = [
  { id: 'income', h: `Richest ZIP codes in ${info.name}`, note: 'By median household income, ZIP codes with 1,000+ residents.', rows: t.income, metric: 'income' as const },
  { id: 'home-value', h: `Most expensive ZIP codes in ${info.name}`, note: 'By median home value, ZIP codes with 1,000+ residents. $1,000,000+ is the highest reported value.', rows: t.home_value, metric: 'home_value' as const },
  { id: 'population', h: `Most populated ZIP codes in ${info.name}`, note: 'By total population.', rows: t.population, metric: 'population' as const },
  { id: 'land-area', h: `Largest ZIP codes in ${info.name} by area`, note: 'By land area in square miles.', rows: t.land_area, metric: 'land_area' as const },
].filter((s) => s.rows.length);

const faqs = [
  ...(t.income[0] ? [{ question: `What is the richest ZIP code in ${info.name}?`, answer: `${t.income[0].zip} in ${t.income[0].city} has the highest median household income in ${info.name} (${formatMoney(t.income[0].median_household_income)}) among ZIP codes with at least 1,000 residents.` }] : []),
  ...(t.home_value[0] ? [{ question: `What is the most expensive ZIP code in ${info.name}?`, answer: `${t.home_value[0].zip} in ${t.home_value[0].city} has the highest median home value in ${info.name}: ${formatMoney(t.home_value[0].median_home_value)}.` }] : []),
  ...(t.population[0] ? [{ question: `Which ZIP code in ${info.name} has the most people?`, answer: `${t.population[0].zip} (${t.population[0].city}) is the most populated, with about ${formatNumber(t.population[0].population)} residents.` }] : []),
  ...(t.land_area[0] ? [{ question: `What is the largest ZIP code in ${info.name}?`, answer: `By land area, ${t.land_area[0].zip} (${t.land_area[0].city}) is the largest at ${formatArea(t.land_area[0].land_area_sqmi)}.` }] : []),
];
const crumbs = [{ name: 'Home', path: '/' }, { name: info.name, path: stateUrl(abbr) }, { name: 'Top ZIP codes', path }];
---

<Base title={title} description={description} path={path} jsonLd={webPageSchema({ path, name: title, description, dateModified: meta.built })}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">Rankings · {info.name}</p>
      <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] sm:text-[2.75rem]">Top ZIP codes in {info.name}</h1>
      {faqs[0] && <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-2" data-answer>{faqs[0].answer} {faqs[1]?.answer}</p>}
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Jump to">
        {sections.map((s) => <a href={`#${s.id}`} class="chip">{s.h.replace(` in ${info.name}`, '').replace(` ${info.name}`, '')}</a>)}
      </nav>
    </header>
    <AdSlot slot="top" />
    <div class="mt-4 space-y-12">
      {sections.map((s, i) => (
        <section id={s.id} class="scroll-mt-24">
          <h2 class="h-section">{s.h}</h2>
          <p class="mt-2 text-sm text-ink-3">{s.note}</p>
          <div class="mt-4"><RankTable rows={s.rows} metric={s.metric} /></div>
          {i === 1 && <AdSlot slot="inContent" />}
        </section>
      ))}
    </div>
    <p class="mt-8 text-sm"><a href={stateUrl(abbr)} class="link">← All {info.name} ZIP codes</a> · <a href="/rankings/" class="link">National rankings</a></p>
    <div class="mt-12 max-w-4xl"><FAQ faqs={faqs} heading={`${info.name} ZIP code rankings FAQ`} /></div>
  </div>
</Base>

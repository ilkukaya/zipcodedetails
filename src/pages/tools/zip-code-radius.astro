---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import FAQ from '../../components/FAQ.astro';
import AdSlot from '../../components/AdSlot.astro';
import { webPageSchema } from '../../lib/seo';
import { getMeta } from '../../lib/data';

const path = '/tools/zip-code-radius/';
const title = 'ZIP Code Radius Search – Find All ZIP Codes Within X Miles';
const description = 'Find every US ZIP code within 1 to 100 miles of any ZIP code. Free radius search with distances, population, and CSV download.';
const faqs = [
  { question: 'How does the ZIP code radius search work?', answer: 'We measure the straight-line distance from the center of your ZIP code to the center of every other US ZIP code and list those within the radius you choose.' },
  { question: 'Can I download the results?', answer: 'Yes. Use “Download CSV” to save the list, or “Copy ZIPs” to copy a comma-separated list for use in ad targeting, delivery zones or spreadsheets.' },
  { question: 'Does a ZIP code count if only part of it is inside the radius?', answer: 'A ZIP code is included when its center point is within the radius. Large rural ZIP codes may extend beyond the radius even when included.' },
];
---

<Base title={title} description={description} path={path} jsonLd={webPageSchema({ path, name: title, description, dateModified: getMeta().built })}>
  <div class="wrap pt-6">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }, { name: 'ZIP code radius', path }]} />
    <div class="mt-6"><PageHeader eyebrow="Free tool" title="ZIP codes within a radius" lede="List all ZIP codes within a set distance of any US ZIP code." /></div>

    <form class="card mt-8 grid max-w-3xl gap-4 p-5 sm:grid-cols-[1fr_12rem_auto] sm:items-end sm:p-6" data-radius>
      <label class="block">
        <span class="eyebrow">Center ZIP</span>
        <input name="zip" inputmode="numeric" pattern="\d{5}" maxlength="5" required placeholder="60601" class="zipcode mt-2 h-12 w-full rounded-lg border border-line-strong bg-surface px-4 text-lg outline-none focus:border-brand focus:ring-2 focus:ring-brand/15" />
      </label>
      <label class="block">
        <span class="eyebrow">Radius</span>
        <select name="r" class="mt-2 h-12 w-full rounded-lg border border-line-strong bg-surface px-3 text-base outline-none focus:border-brand">
          {[1, 3, 5, 10, 15, 25, 50, 75, 100].map((r) => <option value={r} selected={r === 10}>{r} miles</option>)}
        </select>
      </label>
      <button type="submit" class="btn-primary h-12 px-6">Search</button>
    </form>

    <div class="mt-6" data-result aria-live="polite"></div>

    <AdSlot slot="top" />
    <div class="mt-12 max-w-3xl"><FAQ faqs={faqs} heading="About radius search" /></div>
  </div>
</Base>

<script>
  import { loadIndex, nearest, esc, type Row } from '../../scripts/zipindex';
  const form = document.querySelector<HTMLFormElement>('[data-radius]')!;
  const out = document.querySelector<HTMLElement>('[data-result]')!;
  const zipIn = form.elements.namedItem('zip') as HTMLInputElement;
  const rIn = form.elements.namedItem('r') as HTMLSelectElement;
  const params = new URLSearchParams(location.search);
  if (params.get('zip')) zipIn.value = params.get('zip')!;
  if (params.get('r') && [...rIn.options].some((o) => o.value === params.get('r'))) rIn.value = params.get('r')!;

  let last: { row: Row; d: number }[] = [];

  async function run() {
    const z = zipIn.value.trim();
    const r = parseFloat(rIn.value);
    if (!/^\d{5}$/.test(z)) return;
    out.innerHTML = '<p class="text-sm text-ink-3">Searching…</p>';
    const rows = await loadIndex();
    const c = rows.find((x) => x[0] === z);
    if (!c) {
      out.innerHTML = `<p class="max-w-3xl rounded-lg border border-stamp/30 bg-stamp-soft p-4 text-sm">ZIP code ${esc(z)} was not found.</p>`;
      return;
    }
    last = nearest(rows, c[3], c[4], Infinity, r).filter((x) => x.row[0] !== z);
    const pop = last.reduce((s, x) => s + x.row[5], 0);
    out.innerHTML = `
      <div class="flex flex-wrap items-end justify-between gap-3">
        <p class="text-ink-2"><strong class="text-ink">${last.length.toLocaleString()} ZIP codes</strong> within ${r} miles of <a class="zipcode" href="/zip/${z}/">${z}</a> (${esc(c[1])}, ${c[2]}) · ~${pop.toLocaleString()} residents</p>
        <div class="flex gap-2"><button type="button" class="btn-ghost" data-copy>Copy ZIPs</button><button type="button" class="btn-ghost" data-csv>Download CSV</button></div>
      </div>
      <div class="card mt-4 max-h-[36rem] overflow-auto">
        <table class="data-table"><thead><tr><th>ZIP</th><th>City</th><th>State</th><th class="text-right">Distance</th><th class="text-right">Population</th></tr></thead>
        <tbody>${last.slice(0, 1500).map((x) => `<tr><td><a class="zipcode no-underline hover:underline" href="/zip/${x.row[0]}/">${x.row[0]}</a></td><td>${esc(x.row[1])}</td><td>${x.row[2]}</td><td class="num text-right">${x.d.toFixed(1)} mi</td><td class="num text-right">${x.row[5] ? x.row[5].toLocaleString() : '—'}</td></tr>`).join('')}</tbody></table>
      </div>
      ${last.length > 1500 ? '<p class="mt-2 text-xs text-ink-3">Showing the nearest 1,500. The CSV includes all results.</p>' : ''}`;
    out.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
      await navigator.clipboard.writeText(last.map((x) => x.row[0]).join(', '));
      (e.target as HTMLElement).textContent = 'Copied!';
    });
    out.querySelector('[data-csv]')?.addEventListener('click', () => {
      const csv = 'zip,city,state,distance_mi,population\n' + last.map((x) => `${x.row[0]},"${x.row[1]}",${x.row[2]},${x.d.toFixed(2)},${x.row[5]}`).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
      a.download = `zip-codes-within-${r}-miles-of-${z}.csv`;
      a.click();
    });
    history.replaceState(null, '', `?zip=${z}&r=${r}`);
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run();
  });
  if (params.get('zip')) run();
</script>

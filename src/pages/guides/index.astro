---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { GUIDES } from '../../lib/guides';

const title = 'ZIP Code Guides – How ZIP Codes Work';
const description = 'Plain-English guides to US ZIP codes: what they are, what each digit means, ZIP+4, and how to find your own.';
---

<Base title={title} description={description}>
  <div class="wrap pt-6">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }]} />
    <div class="mt-6"><PageHeader eyebrow="Guides" title="ZIP codes, decoded" lede={description} /></div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {GUIDES.map((g) => (
        <a href={`/guides/${g.slug}/`} class="card group p-6 no-underline transition hover:-translate-y-0.5 hover:shadow-lift">
          <h2 class="font-display text-xl font-semibold text-ink group-hover:text-brand">{g.short}</h2>
          <p class="mt-2 text-sm text-ink-2">{g.excerpt}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-brand">Read guide →</span>
        </a>
      ))}
    </div>
  </div>
</Base>

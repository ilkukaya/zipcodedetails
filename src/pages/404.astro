---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
---

<Base title="Page not found – ZIPCodeDetails" description="We couldn't find that page. Search any US ZIP code, city or state." path="/404/" noindex headerSearch={false}>
  <div class="wrap py-20">
    <div class="mx-auto max-w-xl text-center">
      <p class="zipcode inline-block rounded-lg border-2 border-dashed border-stamp px-4 py-1 text-5xl text-stamp">404</p>
      <h1 class="mt-6 font-display text-3xl font-semibold sm:text-4xl">Return to sender</h1>
      <p class="mt-3 text-ink-2" data-hint>That address doesn’t exist. Search for a ZIP code, city or state instead.</p>
      <div class="mt-8"><SearchBox size="lg" /></div>
      <div class="mt-8 flex flex-wrap justify-center gap-2 text-sm">
        <a href="/" class="chip">Home</a>
        <a href="/states/" class="chip">Browse states</a>
        <a href="/what-is-my-zip-code/" class="chip">What’s my ZIP?</a>
      </div>
    </div>
  </div>
</Base>

<script>
  // If someone typed /zip/12345-6789 or /12345, point them at the right page.
  const m = location.pathname.match(/(\d{5})/);
  const hint = document.querySelector('[data-hint]');
  if (m && hint) hint.innerHTML = `Looking for ZIP code <a class="zipcode" href="/zip/${m[1]}/">${m[1]}</a>?`;
</script>

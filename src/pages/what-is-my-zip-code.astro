---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import SearchBox from '../components/SearchBox.astro';
import { webPageSchema } from '../lib/seo';
import { getMeta } from '../lib/data';

const path = '/what-is-my-zip-code/';
const title = 'What Is My ZIP Code? Find Your ZIP Code Instantly';
const description = 'What’s my ZIP code? Tap one button to find the ZIP code for your current location, or search by city. Free, fast and private — your location never leaves your device.';
const faqs = [
  { question: 'How does “What is my ZIP code” work?', answer: 'Your browser shares your approximate coordinates with this page (only after you allow it). The page then finds the nearest ZIP code center from our list of every US ZIP code — entirely on your device. Nothing is sent to our servers.' },
  { question: 'Why might the result be wrong?', answer: 'ZIP codes are delivery routes, not perfect shapes, and we match to the nearest ZIP center. Near a ZIP boundary the neighboring ZIP can be closer. For your exact 5-digit ZIP and ZIP+4, check your address with the USPS ZIP code lookup.' },
  { question: 'How else can I find my ZIP code?', answer: 'Look at any mail you have received, a utility bill, or your driver’s license. You can also search your city above to see every ZIP code that serves it.' },
  { question: 'What is my ZIP+4 code?', answer: 'ZIP+4 adds four digits that identify your block or building. It depends on your exact street address, so use the official USPS lookup to find it.' },
];
---

<Base title={title} description={description} path={path} jsonLd={webPageSchema({ path, name: title, description, dateModified: getMeta().built })}>
  <div class="wrap pt-6">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'What is my ZIP code?', path }]} />
    <div class="mx-auto mt-10 max-w-2xl text-center">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-3 font-display text-[2.2rem] font-semibold leading-[1.1] sm:text-5xl">What is my ZIP code?</h1>
      <p class="mt-4 text-[1.08rem] text-ink-2" data-answer>Tap the button to find the ZIP code for where you are right now. Your location is processed on your device only.</p>
      <button type="button" class="btn-primary mt-8 h-14 px-8 text-base" data-locate>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /><circle cx="12" cy="12" r="8" /></svg>
        Find my ZIP code
      </button>
      <div class="mt-8 text-left" data-out aria-live="polite"></div>
      <div class="mt-10">
        <p class="mb-3 text-sm text-ink-3">Or search by city or ZIP:</p>
        <SearchBox size="lg" />
      </div>
    </div>
    <AdSlot slot="top" />
    <div class="mx-auto mt-12 max-w-3xl"><FAQ faqs={faqs} /></div>
  </div>
</Base>

<script>
  import { loadIndex, nearest, esc } from '../scripts/zipindex';
  const btn = document.querySelector<HTMLButtonElement>('[data-locate]')!;
  const out = document.querySelector<HTMLElement>('[data-out]')!;
  const msg = (t: string) => (out.innerHTML = `<p class="rounded-lg border border-line bg-surface p-4 text-center text-sm text-ink-2">${t}</p>`);
  btn.addEventListener('click', () => {
    if (!('geolocation' in navigator)) return msg('Your browser does not support location. Search by city below instead.');
    msg('Finding your location…');
    loadIndex();
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const rows = await loadIndex();
        const res = nearest(rows, pos.coords.latitude, pos.coords.longitude, 4);
        if (!res.length || res[0].d > 60) return msg('You appear to be outside the United States. Search a US city below.');
        const [best, ...alt] = res;
        out.innerHTML = `
          <div class="card p-6 text-center">
            <p class="eyebrow">Your ZIP code is most likely</p>
            <a href="/zip/${best.row[0]}/" class="zipcode mt-3 inline-block rounded-xl border-2 border-ink px-5 py-2 text-5xl text-ink no-underline hover:border-brand hover:text-brand">${best.row[0]}</a>
            <p class="mt-3 text-lg text-ink-2">${esc(best.row[1])}, ${best.row[2]}</p>
            <a href="/zip/${best.row[0]}/" class="btn-ghost mt-5">See details for ${best.row[0]} →</a>
            <p class="mt-6 text-sm text-ink-3">Near a boundary? Nearby ZIP codes: ${alt.map((a) => `<a class="zipcode" href="/zip/${a.row[0]}/">${a.row[0]}</a> <span class="text-ink-4">(${esc(a.row[1])})</span>`).join(', ')}</p>
          </div>`;
      },
      (err) => msg(err.code === 1 ? 'Location permission was denied. You can search by city below.' : 'We couldn’t get your location. Please try again or search below.'),
      { enableHighAccuracy: false, timeout: 12000, maximumAge: 600000 }
    );
  });
</script>

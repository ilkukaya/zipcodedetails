---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SearchBox from '../components/SearchBox.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPopular } from '../lib/data';
import { zipUrl } from '../lib/url';

const title = 'ZIP Code Lookup – Search Any US ZIP Code, City or State';
const description = 'Free ZIP code lookup. Search any US ZIP code to find its city, county, state, time zone and map — or type a city to see all of its ZIP codes.';
const popular = [
  ['90210', 'Beverly Hills, CA'], ['10001', 'New York, NY'], ['60601', 'Chicago, IL'], ['77001', 'Houston, TX'],
  ['33101', 'Miami, FL'], ['98101', 'Seattle, WA'], ['30301', 'Atlanta, GA'], ['02108', 'Boston, MA'],
  ['85001', 'Phoenix, AZ'], ['80202', 'Denver, CO'], ['94102', 'San Francisco, CA'], ['20001', 'Washington, DC'],
];
const biggest = getPopular().slice(0, 12);
---

<Base title={title} description={description} headerSearch={false}>
  <div class="wrap pt-6">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'ZIP code lookup', path: '/search/' }]} />
    <div class="mx-auto mt-10 max-w-2xl">
      <h1 class="text-center font-display text-[2.2rem] font-semibold leading-[1.1] sm:text-5xl">ZIP code lookup</h1>
      <p class="mt-4 text-center text-[1.05rem] text-ink-2">Type a ZIP code, a city (“Austin, TX”) or a state.</p>
      <div class="mt-8"><SearchBox size="lg" autofocus /></div>
      <div class="mt-8" data-results aria-live="polite"></div>
    </div>

    <AdSlot slot="top" />

    <div class="mx-auto mt-12 grid max-w-5xl gap-10 md:grid-cols-2">
      <section>
        <h2 class="h-section">Popular lookups</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {popular.map(([z, l]) => <a href={zipUrl(z)} class="chip"><span class="zipcode text-ink">{z}</span><span class="text-ink-3">{l}</span></a>)}
        </div>
      </section>
      <section>
        <h2 class="h-section">Most populated ZIP codes</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {biggest.map((r) => <a href={zipUrl(r.zip)} class="chip"><span class="zipcode text-ink">{r.zip}</span><span class="text-ink-3">{r.city}, {r.state}</span></a>)}
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import { loadIndex, search, hitUrl, esc } from '../scripts/zipindex';
  const q = new URLSearchParams(location.search).get('q')?.trim();
  const out = document.querySelector<HTMLElement>('[data-results]')!;
  const input = document.querySelector<HTMLInputElement>('form[data-searchbox] input');
  if (q) {
    if (input) input.value = q;
    loadIndex().then((rows) => {
      const hits = search(rows, q, 50);
      if (!hits.length) {
        out.innerHTML = `<p class="rounded-lg border border-line bg-surface p-4 text-sm text-ink-2">No results for “${esc(q)}”. Try a 5-digit ZIP code or a city name, e.g. “Denver” or “Denver, CO”.</p>`;
        return;
      }
      if (hits.length === 1) {
        location.replace(hitUrl(hits[0]));
        return;
      }
      out.innerHTML = `<p class="mb-3 text-sm text-ink-3">${hits.length} results for “${esc(q)}”</p><ul class="card divide-y divide-line">${hits
        .map((h) => {
          const label = h.kind === 'zip' ? `<span class="zipcode text-ink">${h.zip}</span> <span class="text-ink-2">${esc(h.city)}, ${h.state}</span>`
            : h.kind === 'city' ? `<span class="font-medium text-ink">${esc(h.city)}, ${h.state}</span> <span class="text-sm text-ink-3">${h.count} ZIP${h.count === 1 ? '' : 's'}</span>`
            : `<span class="font-medium text-ink">${esc(h.name)}</span> <span class="text-sm text-ink-3">state</span>`;
          return `<li><a href="${hitUrl(h)}" class="flex items-center justify-between px-4 py-3 no-underline hover:bg-paper"><span>${label}</span><span aria-hidden="true" class="text-ink-4">→</span></a></li>`;
        })
        .join('')}</ul>`;
    });
  }
</script>

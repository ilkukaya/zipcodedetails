---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import AdSlot from '../../components/AdSlot.astro';
import Stats from '../../components/Stats.astro';
import ZipTable from '../../components/ZipTable.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getStates, getZips, getCountiesByState, getCities, getMeta, getRankings, type StateInfo } from '../../lib/data';
import { formatNumber, formatMoney, formatArea, getTimezoneName, listJoin, citySlug } from '../../lib/formatters';
import { cityUrl, countyUrl, stateUrl, topUrl, zipUrl, abs } from '../../lib/url';
import { webPageSchema, clampDescription } from '../../lib/seo';

export function getStaticPaths() {
  return Object.entries(getStates()).map(([abbr, info]) => ({ params: { state: abbr.toLowerCase() }, props: { abbr, info } }));
}

const { abbr, info } = Astro.props as { abbr: string; info: StateInfo };
const meta = getMeta();
const zips = getZips(info.zips);
const path = stateUrl(abbr);
const cities = getCities();
const counties = (getCountiesByState()[abbr] || []).sort((a, b) => a.info.county.localeCompare(b.info.county));
const top = getRankings().states[abbr];
const tzNames = [...new Set(info.timezones.map(getTimezoneName))];
const bigCities = info.largest_cities.filter((c) => cities[citySlug(c, abbr)]);

const answer = `${info.name} has ${formatNumber(info.zip_count)} ZIP codes, ranging from ${info.zip_range[0]} to ${info.zip_range[1]}. They serve ${formatNumber(info.city_count)} cities and towns across ${formatNumber(info.county_count)} ${info.county_count === 1 ? 'county' : 'counties'}${bigCities.length ? `; the largest by population is ${bigCities[0]}` : ''}. ${info.po_box_count ? `${formatNumber(info.po_box_count)} of them are PO Box–only ZIP codes.` : ''}`;

const title = `${info.name} ZIP Codes – Complete List of ${formatNumber(info.zip_count)} ZIPs by City & County`;
const description = clampDescription(`All ${formatNumber(info.zip_count)} ${info.name} ZIP codes (${info.zip_range[0]}–${info.zip_range[1]}) with city, county, population and income. Browse by city or county, or sort the full ${abbr} ZIP code list.`);

const facts = [
  { k: 'ZIP codes', v: formatNumber(info.zip_count), sub: `${info.zip_range[0]} – ${info.zip_range[1]}` },
  { k: 'Cities & towns', v: formatNumber(info.city_count) },
  { k: 'Counties', v: formatNumber(info.county_count) },
  ...(info.population ? [{ k: 'Population', v: formatNumber(info.population), sub: 'Sum of ZIP areas' }] : []),
  ...(info.median_zip_income ? [{ k: 'Median ZIP income', v: formatMoney(info.median_zip_income), sub: 'Typical ZIP code' }] : []),
  ...(info.median_zip_home_value ? [{ k: 'Median ZIP home value', v: formatMoney(info.median_zip_home_value), sub: 'Typical ZIP code' }] : []),
  { k: tzNames.length > 1 ? 'Time zones' : 'Time zone', v: tzNames.slice(0, 2).join(', ') || '—' },
  ...(info.land_area_sqmi ? [{ k: 'Land area', v: formatArea(info.land_area_sqmi), sub: 'ZIP areas combined' }] : []),
];

const faqs = [
  { question: `How many ZIP codes are in ${info.name}?`, answer: `There are ${formatNumber(info.zip_count)} ZIP codes in ${info.name}: ${formatNumber(info.zip_count - info.po_box_count)} standard and ${formatNumber(info.po_box_count)} PO Box ZIP codes.` },
  { question: `What is the ZIP code range for ${info.name}?`, answer: `${info.name} ZIP codes run from ${info.zip_range[0]} to ${info.zip_range[1]}.` },
  { question: `What is the ZIP code for ${info.name}?`, answer: `There is no single ZIP code for ${info.name}. Each city and neighborhood has its own; ${bigCities.length ? `for example ${listJoin(bigCities.slice(0, 3).map((c) => `${c} (${cities[citySlug(c, abbr)].zips[0]})`))}.` : 'search by city above.'}` },
  ...(top?.population?.[0] ? [{ question: `What is the most populated ZIP code in ${info.name}?`, answer: `${top.population[0].zip} in ${top.population[0].city} is the most populated ZIP code in ${info.name}, with about ${formatNumber(top.population[0].population)} residents.` }] : []),
  ...(top?.income?.[0] ? [{ question: `What is the richest ZIP code in ${info.name}?`, answer: `Among ZIP codes with at least 1,000 residents, ${top.income[0].zip} (${top.income[0].city}) has the highest median household income in ${info.name}: ${formatMoney(top.income[0].median_household_income)}.` }] : []),
  { question: `What time zone is ${info.name} in?`, answer: tzNames.length > 1 ? `${info.name} spans ${listJoin(tzNames)}. Check a specific ZIP code page for its local time.` : `${info.name} is in ${tzNames[0] || 'its local time zone'}.` },
];

const crumbs = [{ name: 'Home', path: '/' }, { name: 'States', path: '/states/' }, { name: info.name, path }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'State',
  '@id': abs(path) + '#place',
  name: info.name,
  url: abs(path),
  containedInPlace: { '@type': 'Country', name: 'United States', sameAs: 'https://www.wikidata.org/wiki/Q30' },
};
---

<Base title={title} description={description} path={path} jsonLd={[schema, webPageSchema({ path, name: title, description, dateModified: meta.built, about: { '@id': abs(path) + '#place' } })]}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">State ZIP codes · {abbr}</p>
      <h1 class="mt-3 font-display text-[2rem] font-semibold leading-[1.1] sm:text-[2.75rem]">{info.name} ZIP Codes</h1>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-2" data-answer>{answer}</p>
      <div class="mt-6 max-w-xl"><SearchBox size="sm" placeholder={`Search a city or ZIP in ${info.name}`} /></div>
    </header>

    <div class="mt-8"><Stats items={facts} /></div>

    <AdSlot slot="top" />

    {bigCities.length > 0 && (
      <section class="mt-10">
        <h2 class="h-section">Largest cities in {info.name}</h2>
        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
          {bigCities.map((c) => {
            const ci = cities[citySlug(c, abbr)];
            return (
              <a href={cityUrl(citySlug(c, abbr))} class="flex items-center justify-between rounded-lg border border-line bg-surface px-4 py-3 no-underline transition hover:border-brand/40">
                <span class="truncate font-medium text-ink">{c}</span>
                <span class="num ml-2 shrink-0 text-xs text-ink-3">{ci.zips.length} ZIP{ci.zips.length === 1 ? '' : 's'}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {top && (
      <section class="mt-10">
        <div class="flex items-end justify-between gap-3">
          <h2 class="h-section">Top ZIP codes in {info.name}</h2>
          <a href={topUrl(abbr)} class="shrink-0 text-sm link">Full rankings →</a>
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {[
            { t: 'Most populated', rows: top.population, f: (r: any) => formatNumber(r.population) },
            { t: 'Highest income', rows: top.income, f: (r: any) => formatMoney(r.median_household_income) },
            { t: 'Most expensive homes', rows: top.home_value, f: (r: any) => formatMoney(r.median_home_value) },
          ].map((b) => (
            <div class="card p-5">
              <p class="eyebrow">{b.t}</p>
              <ol class="mt-3 space-y-2 text-sm">
                {b.rows.slice(0, 5).map((r, i) => (
                  <li class="flex items-baseline justify-between gap-2">
                    <span class="truncate"><span class="num mr-2 text-ink-4">{i + 1}</span><a href={zipUrl(r.zip)} class="lz">{r.zip}</a> <span class="text-ink-3">{r.city}</span></span>
                    <span class="num shrink-0 font-medium text-ink">{b.f(r)}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    )}

    {counties.length > 0 && (
      <section class="mt-10">
        <h2 class="h-section">{info.name} ZIP codes by county</h2>
        <div class="mt-4 grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-4">
          {counties.map((c) => (
            <a href={countyUrl(c.slug)} class="flex items-center justify-between border-b border-line py-2 text-sm no-underline hover:text-brand">
              <span class="text-ink-2">{c.info.county}</span>
              <span class="num text-ink-4">{c.info.zip_count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10" id="all">
      <h2 class="h-section">All {formatNumber(info.zip_count)} {info.name} ZIP codes</h2>
      <p class="mt-2 text-sm text-ink-3">Tap a column to sort by ZIP, city, county, population or income.</p>
      <div class="mt-5"><ZipTable rows={zips} showCounty caption={`All ZIP codes in ${info.name}`} /></div>
    </section>

    <AdSlot slot="inContent" />
    <div class="mt-12 max-w-4xl"><FAQ faqs={faqs} heading={`${info.name} ZIP code FAQ`} /></div>
  </div>
</Base>
